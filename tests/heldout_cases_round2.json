[
  {"id": "U01", "turns": ["could you delete customer 12583"],
   "expect": {"action_type": ["write"], "intent": ["delete_record"], "is_destructive": true,
              "constraints": [{"column": "customer_id", "operator": "=", "value": "12583"}]}},
  {"id": "U02", "turns": ["which products were deleted last year"],
   "expect": {"action_type": ["read"], "is_destructive": false}},
  {"id": "U03", "turns": ["modify the quantity for invoice 536365 to 10"],
   "expect": {"action_type": ["write"], "intent": ["update_record"],
              "constraints": [{"column": "invoice_no", "operator": "=", "value": "536365"}],
              "set_values": {"quantity": 10}}},
  {"id": "U04", "turns": ["set status to cancelled for invoice 536366"],
   "expect": {"action_type": ["write"], "intent": ["update_record"],
              "constraints": [{"column": "invoice_no", "operator": "=", "value": "536366"}],
              "set_values": {"status": "cancelled"}}},
  {"id": "U05", "turns": ["products with a price over 50"],
   "expect": {"action_type": ["read"],
              "constraints": [{"column": "unit_price", "operator": ">", "value": 50}]}},
  {"id": "U06", "turns": ["line items where quantity is at most 2"],
   "expect": {"action_type": ["read"],
              "constraints": [{"column": "quantity", "operator": "<=", "value": 2}]}},
  {"id": "U07", "turns": ["invoices from Australia in 2011"],
   "expect": {"action_type": ["read"],
              "constraints": [{"column": "country", "operator": "=", "value": "Australia"},
                              {"column": "invoice_date", "operator": "year", "value": 2011}]}},
  {"id": "U08", "turns": ["average price per country"],
   "expect": {"action_type": ["read"], "intent": ["aggregate_avg"]}},
  {"id": "U09", "turns": ["count customers per country"],
   "expect": {"action_type": ["read"], "intent": ["aggregate_count"]}},
  {"id": "U10", "turns": ["please truncate the products table"],
   "expect": {"action_type": ["ddl"], "intent": ["truncate_table"], "is_destructive": true}},
  {"id": "U11", "turns": ["how many invoices were cancelled in 2011"],
   "expect": {"action_type": ["read"], "intent": ["aggregate_count"], "is_destructive": false,
              "constraints": [{"column": "status", "operator": "=", "value": "cancelled"},
                              {"column": "invoice_date", "operator": "year", "value": 2011}]}},
  {"id": "U12", "turns": ["show customers from Germany", "what about Spain"],
   "expect": {"action_type": ["read"],
              "constraints": [{"column": "country", "operator": "=", "value": "Spain"}]}},
  {"id": "U13", "turns": ["list invoices in 2010", "only cancelled ones"],
   "expect": {"action_type": ["read"],
              "constraints": [{"column": "invoice_date", "operator": "year", "value": 2010},
                              {"column": "status", "operator": "=", "value": "cancelled"}]}},
  {"id": "U14", "turns": ["remove every invoice item with quantity below 0"],
   "expect": {"action_type": ["write"], "intent": ["delete_record"], "is_destructive": true,
              "constraints": [{"column": "quantity", "operator": "<", "value": 0}]}},
  {"id": "U15", "turns": ["total sales per month"],
   "expect": {"action_type": ["read"], "intent": ["aggregate_sum"]}}
]